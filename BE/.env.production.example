# Backend production environment
# Copy to backend/.env for deployment
NODE_ENV=production
PORT=3001

# Public frontend deployment URL
FRONTEND_URL=https://app.example.com
APP_BASE_URL=https://app.example.com

# Allowed origins for CORS
CORS_ORIGINS=https://app.example.com

# Database / Redis / AI runtime
# Managed MySQL (Aiven) requires TLS: append `?sslaccept=accept_invalid_certs`
# to the connection string handed out by the provider.
DATABASE_URL="mysql://examtrust:CHANGE_ME@db:3306/examtrust"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Managed Redis (Aiven Valkey / Upstash) uses one TLS URI and overrides the
# three settings above when present.
# REDIS_URL="rediss://default:<password>@valkey-xxxx.a.aivencloud.com:12345"

# Valid values: google | ollama | nvidia | openrouter | deepseek
AI_PROVIDER=ollama
AI_OLLAMA_URL=http://ollama:11434
AI_OLLAMA_MODEL=gemma3:4b
# Separate, lightweight image model used only for webcam evidence tags.
# Run `ollama pull moondream` on the Ollama host before enabling the worker.
AI_OLLAMA_VISION_MODEL=moondream
AI_OLLAMA_TEMPERATURE=0.2
AI_OLLAMA_TOP_P=0.85
AI_OLLAMA_REPEAT_PENALTY=1.1
AI_OLLAMA_NUM_CTX=8192
AI_APP_NAME=ExamTrust
AI_DEFAULT_LANGUAGE=vi

# Only needed when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Note: proctoring evidence image analysis (vision) is only supported when
# AI_PROVIDER=ollama or AI_PROVIDER=google — OpenRouter/DeepSeek/NVIDIA are
# text-only here and will report the feature as unconfigured.

# Only needed when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat

JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=360d

# Cloudflare R2 (S3-compatible) — stores question media attachments
# (images/audio). Create a bucket + a scoped API token (Object Read & Write,
# restricted to that one bucket) in the Cloudflare dashboard. R2_ENDPOINT is
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. R2_PUBLIC_BASE_URL is the
# bucket's public r2.dev URL (or a custom domain), used to build the URL
# saved on the question — it does NOT need credentials since egress reads
# are public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=examtrust-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
