{
  "name": "examtrust-backend",
  "version": "1.2.2",
  "description": "ExamTrust Backend API - NestJS + Prisma + MySQL",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main.js",
    "start:prod:build": "npm run build && node dist/main.js",
    "ai:worker": "node dist/ai-worker.js",
    "ai:worker:dev": "ts-node src/ai-worker.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "db:rebuild": "prisma db push --force-reset --accept-data-loss --schema prisma/schema.prisma && npm run seed:all",
    "db:clear-content": "ts-node prisma/clear-academic-data.ts",
    "backfill:question-v2": "ts-node scripts/backfill-question-v2.ts",
    "seed:all": "ts-node --transpile-only prisma/seed-master.ts",
    "seed:analytics-demo": "ts-node --transpile-only prisma/seed-analytics-ui-demo.ts",
    "seed:duplicate-demo": "ts-node --transpile-only prisma/seed-duplicate-demo.ts",
    "seed:monitor-demo": "ts-node --transpile-only prisma/seed-monitor-ui-demo.ts",
    "seed:question-history-demo": "ts-node --transpile-only prisma/seed-question-history-demo.ts",
    "seed:topic-similarity-demo": "ts-node --transpile-only prisma/seed-topic-similarity-demo.ts",
    "seed:users": "ts-node --transpile-only prisma/seed-users.ts",
    "seed:courses": "ts-node --transpile-only prisma/seed-courses.ts",
    "seed:questions": "ts-node --transpile-only prisma/seed-question-bank.ts",
    "seed:duplicates": "ts-node --transpile-only prisma/seed-question-bank-duplicates.ts",
    "seed:topics": "ts-node --transpile-only prisma/seed-topics.ts",
    "seed:exams": "ts-node --transpile-only prisma/seed-exams.ts",
    "seed:submissions": "ts-node --transpile-only prisma/seed-submissions.ts",
    "seed:integrity": "ts-node --transpile-only prisma/seed-integrity.ts",
    "seed:grading": "ts-node --transpile-only prisma/seed-grading-adjustments.ts",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs/bull": "^10.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.19.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.11.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "ioredis": "^5.3.2",
    "jsonrepair": "^3.15.0",
    "openai": "^6.46.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.2",
    "prisma": "^6.19.2",
    "redis": "^4.6.11",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/pdfkit": "^0.13.9",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
