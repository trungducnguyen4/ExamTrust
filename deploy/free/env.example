# ExamTrust — production env for the free single-VM deployment.
# Copy to deploy/free/.env (never commit). bootstrap.sh generates the secrets
# marked CHANGE_ME automatically; the rest you fill once.

# --- Public address of the API -----------------------------------------------
# Use the VM public IP with sslip.io (free wildcard DNS, Caddy gets a real
# Let's Encrypt certificate) or your own domain pointing to the VM.
# Example: 140.238.1.2.sslip.io
API_DOMAIN=CHANGE_ME.sslip.io

# --- Database (internal to the compose network) ------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=examtrust
MYSQL_USER=examtrust
MYSQL_PASSWORD=CHANGE_ME

# --- Backend runtime ---------------------------------------------------------
NODE_ENV=production
PORT=3001
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# The Vercel frontend URL (and any custom domain) — used for CORS and links.
FRONTEND_URL=https://exam-trust.vercel.app
APP_BASE_URL=https://exam-trust.vercel.app
CORS_ORIGINS=https://exam-trust.vercel.app

# --- AI provider (deepseek | google | openrouter | nvidia | ollama) ----------
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEFAULT_LANGUAGE=vi
AI_APP_NAME=ExamTrust

# --- Cloudflare R2 (question media + proctoring evidence) --------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=examtrust-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# --- Email (optional) --------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM="ExamTrust <no-reply@examtrust.local>"
MAILER_ALLOW_SELF_SIGNED=false
IP_RETENTION_DAYS=90
